# Where this application's database lives.
# Copy to .env and set the URL. See SETUP_DB.md for the full walkthrough.
#
# Replace USER with your username (`whoami`) and pick the line that matches
# where you created the database. Then run:  python main.py db setup

# --- a server you created just for this app (SETUP_DB.md, Option A) ---
DATABASE_URL=postgresql://USER@localhost:5433/clouddesk_rag

# --- a database on a Postgres you already run (Option B) ---
# DATABASE_URL=postgresql://USER@localhost:5432/clouddesk_rag

# --- managed Postgres: Neon, Supabase, RDS (Option C) ---
# DATABASE_URL=postgresql://USER:PASSWORD@host.neon.tech/clouddesk_rag?sslmode=require
